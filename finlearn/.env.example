PORT=8000

DB_USER=postgres
DB_PASSWORD=<your-postgres-password>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finlearn

JWT_SECRET=<generate-it-with-openssl> # openssl rand -hex 32
ACCESS_TOKEN_LIFETIME=15m # default: 15m
REFRESH_TOKEN_LIFETIME=7d # default: 7d

VITE_API_BASE_URL=/api # default: /api

# --- Docker ---
# En producción, descomentar para que `docker compose up` NO cargue docker-compose.override.yml
# COMPOSE_FILE=docker-compose.yml

# Solo docker-compose.override.yml lo define (no tocar para desarrollo local)
# SERVER_HOST=server # host del backend para el proxy de Vite dentro de Docker
